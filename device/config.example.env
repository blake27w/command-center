# Command Center daemon — copy to .env and fill in.
# .env is gitignored. The service key belongs on this machine and nowhere else:
# it bypasses row-level security entirely, so it must never reach a browser,
# a repo, or a screenshot.

SUPABASE_URL=https://YOURPROJECT.supabase.co

# Supabase dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_KEY=

# Matches the row seeded in migration 002. Change both if you rename it.
DEVICE_ID=mac-mini
DEVICE_LABEL=Mac mini (home)

# Passed through to the workloads that need them (agent.run in particular).
ANTHROPIC_API_KEY=
OWNER_USER_ID=

HEARTBEAT_SECONDS=30
SWEEP_SECONDS=60
LOG_MAX_MB=8
